# GL.iNet: PREROUTING connmark restore — copy the FULL ct mark to the skb so vendor
# bits (e.g. GL policy routing 0x8000) coexist with the Tailscale mark band.
#
# Before: meta mark set ct mark & TailscaleFwmarkMask  (wipes all other skb mark bits)
# After:  meta mark set ct mark                        (keeps whatever ct carries)
#
# Upstream has meanwhile adopted the other half of this change: since the rewrite of
# makeConnmarkRestoreExprs, tailscale itself guards the rule with
#   ct mark & TailscaleFwmarkMask != 0
# so the rule no longer runs — and no longer zeroes the skb mark — when the Tailscale
# band is empty. Do NOT re-add that guard; the only remaining GL delta is reloading the
# unmasked ct mark into register 1 before the meta-mark assignment.
#
# nftables Bitwise can only do (register & CONST) ^ CONST, so a true merge
#   meta mark = (meta mark & ~0xff0000) | (ct mark & 0xff0000)
# is not expressible. Both variants therefore overwrite the skb mark; this one
# overwrites it with ct's own bits instead of zeros, which is what GL firmware needs.
#
# Rebased against: tailscale v1.102.1  (see patches/README.md, PATCHES_TESTED_TAG)
# Retire this patch once patches/verify/gl_invariants_test.go passes without it.
#
diff --git a/util/linuxfw/nftables_runner.go b/util/linuxfw/nftables_runner.go
index dd09618..0c82dc9 100644
--- a/util/linuxfw/nftables_runner.go
+++ b/util/linuxfw/nftables_runner.go
@@ -2186,7 +2186,13 @@ func makeConnmarkRestoreExprs() []expr.Any {
 			Register: 1,
 			Data:     []byte{0, 0, 0, 0},
 		},
-		// Set packet mark from register 1 (contains ct mark & 0xff0000)
+		// GL.iNet: reload the FULL ct mark before writing it to the skb, so vendor
+		// bits (e.g. GL policy routing 0x8000) survive instead of being masked away.
+		&expr.Ct{
+			Register: 1,
+			Key:      expr.CtKeyMARK,
+		},
+		// Set packet mark from register 1 (contains the full ct mark)
 		&expr.Meta{
 			Key:            expr.MetaKeyMARK,
 			SourceRegister: true,
